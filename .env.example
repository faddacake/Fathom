# ════════════════════════════════════════════════════════════════════════════
# FATHOM — ENVIRONMENT VARIABLES
# Copy this to .env.local and fill in all values before running.
# Never commit .env.local to git.
# ════════════════════════════════════════════════════════════════════════════

# ── APP ───────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Production: https://fathom.trade

# ── CLERK (auth) ──────────────────────────────────────────────────────────────
# Get from: https://dashboard.clerk.com → your app → API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard

# ── SUPABASE ──────────────────────────────────────────────────────────────────
# Get from: https://supabase.com → your project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...   # ⚠️  NEVER expose this client-side

# ── STRIPE ────────────────────────────────────────────────────────────────────
# Get from: https://dashboard.stripe.com → Developers → API keys
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Webhook secret — get from: stripe listen --forward-to localhost:3000/api/webhooks/stripe
STRIPE_WEBHOOK_SECRET=whsec_...

# Platform price IDs (create in Stripe Dashboard → Products)
STRIPE_PRICE_STARTER_MONTHLY=price_...
STRIPE_PRICE_STARTER_ANNUAL=price_...
STRIPE_PRICE_PRO_MONTHLY=price_...
STRIPE_PRICE_PRO_ANNUAL=price_...
STRIPE_PRICE_WHALE_MONTHLY=price_...
STRIPE_PRICE_WHALE_ANNUAL=price_...

# API credit price IDs
STRIPE_PRICE_API_500=price_...
STRIPE_PRICE_API_2500=price_...
STRIPE_PRICE_API_10000=price_...

# Discord bot price IDs
STRIPE_PRICE_BOT_BASIC=price_...
STRIPE_PRICE_BOT_PRO=price_...
STRIPE_PRICE_BOT_SERVER=price_...

# Founding member coupon
STRIPE_COUPON_FOUNDER=FOUNDER40

# ── UPSTASH REDIS ─────────────────────────────────────────────────────────────
# Get from: https://console.upstash.com → your database → REST API
UPSTASH_REDIS_REST_URL=https://...upstash.io
UPSTASH_REDIS_REST_TOKEN=...

# ── POLYGON.IO ────────────────────────────────────────────────────────────────
# Get from: https://polygon.io → Dashboard → API Keys
POLYGON_API_KEY=...

# ── DISCORD BOT ───────────────────────────────────────────────────────────────
# Internal bot API for Discord role sync (your Railway bot exposes this)
BOT_API_URL=https://your-bot.railway.app
BOT_API_SECRET=...   # shared secret between Next.js app and bot

DISCORD_GUILD_ID=...
DISCORD_BOT_TOKEN=...

# ── RESEND (email) ────────────────────────────────────────────────────────────
# Get from: https://resend.com → API Keys
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=alerts@fathom.trade

# ── MONITORING ────────────────────────────────────────────────────────────────
# Sentry — get from https://sentry.io → your project → Settings → SDK
NEXT_PUBLIC_SENTRY_DSN=https://...@sentry.io/...
SENTRY_AUTH_TOKEN=...

# PostHog — get from https://posthog.com → Project Settings
NEXT_PUBLIC_POSTHOG_KEY=phc_...
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com
